# Copie para .env e ajuste. Todos têm valor padrão — a app sobe sem nenhum deles.

PORT=3000

# Segredo usado para assinar os tokens JWT. Troque em produção!
JWT_SECRET=troque-este-segredo-em-producao
JWT_EXPIRES_IN=7200            # segundos (2h)

# Segredo compartilhado com o gateway de pagamento para validar o webhook.
PAYMENT_WEBHOOK_SECRET=troque-este-segredo-de-webhook

# Conta admin criada automaticamente no seed inicial.
ADMIN_EMAIL=admin@focinhofeliz.com.br
ADMIN_PASSWORD=admin123

# ---- E-mail (confirmação de cadastro / redefinição de senha) ----
# Sem SMTP_HOST: modo dev — o e-mail é gravado em data/emails/*.txt e o
# código aparece no console do servidor.
MAIL_FROM=Focinho Feliz <LivrariaLeitura01@gmail.com>

# Para enviar e-mail de verdade pelo Gmail:
#   1. instale o nodemailer:  npm install nodemailer
#   2. gere uma "Senha de app" em Conta Google > Segurança > Senhas de app
#   3. preencha abaixo
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=LivrariaLeitura01@gmail.com
# SMTP_PASS=xxxxxxxxxxxxxxxx

# Validade do código de confirmação, em minutos (padrão 15)
CODE_TTL_MIN=15
