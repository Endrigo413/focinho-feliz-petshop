# Copie para .env e ajuste. Todos têm valor padrão — a app sobe sem nenhum deles.

PORT=3000

# Segredo usado para assinar os tokens JWT. Troque em produção!
JWT_SECRET=troque-este-segredo-em-producao
JWT_EXPIRES_IN=7200            # segundos (2h)

# Segredo compartilhado com o gateway de pagamento para validar o webhook.
PAYMENT_WEBHOOK_SECRET=troque-este-segredo-de-webhook

# Conta admin criada automaticamente no seed inicial.
ADMIN_EMAIL=admin@focinhofeliz.com.br
ADMIN_PASSWORD=admin123
